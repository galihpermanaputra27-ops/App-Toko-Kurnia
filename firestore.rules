rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read for products, write allowed for store admin management
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Public read for categories, write allowed for store admin management
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Public read for settings (store profile, hero banners), write allowed for admin
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
